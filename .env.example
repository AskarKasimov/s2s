# Номер выделенной GPU 80 ГБ из nvidia-smi. На однокарточном сервере — 0.
GPU_ID=0
# Внутренний порт движка vLLM-Omni (опубликован только на 127.0.0.1).
S2S_PORT=8091
# Порт и интерфейс HTTP API для приложения (POST /speech-to-speech и POST /chat).
S2S_API_PORT=8002
S2S_API_BIND=0.0.0.0
# Каталог с весами модели: требуется минимум 40 GiB свободного места.
# Для другого диска укажите абсолютный путь, например /srv/qwen3-omni.
S2S_DATA_DIR=./data
# Необязательно для публичной модели. Нужен только при лимитах Hugging Face.
HF_TOKEN=
